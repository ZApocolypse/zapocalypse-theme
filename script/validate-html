#!/usr/bin/env ruby
# frozen_string_literal: true


require "w3c_validators"

def validator(file)
  extension = File.extname(file)
  if extension == ".md"
    W3CValidators::NuValidator.new
  elsif extension == ".scss"
    W3CValidators::scssValidator.new
  end
end

def validate(file)
  puts "Checking #{file}..."

  path = File.expand_path "/#{file}", __dir__
  results = validator(file).validate_file(path)

  return puts "Valid!" if results.errors.empty?

  results.errors.each { |err| puts err }
  exit 1
end

if File.exist?("example-site/index.md")
  validate("example-site/index.md")
else
  puts "Skipping HTML validation: example-site/index.md does not exist."
end
validate File.join "assets", "css", "style.scss"
